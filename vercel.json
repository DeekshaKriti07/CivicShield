{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "backend/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/tests/**,frontend/test-results/**,backend/tests/**}"
    }
  }
}
