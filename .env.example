# Local development only. Do not commit .env or credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./civicshield.db
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
AI_ENABLED=false
# Optional model service (not needed for the default rule-based analysis):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
AI_TIMEOUT_SECONDS=15
# Optional path to an administrator-verified facility JSON file:
FACILITIES_FILE=
